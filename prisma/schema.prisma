generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  name         String?   @db.VarChar(100)
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  articles     Article[]
  productsCreated   Product[]   @relation("CreatedProducts")
  articlesCreated   Article[]   @relation("CreatedArticles")
  galleriesCreated  Gallery[]   @relation("CreatedGalleries")
  categoriesCreated Category[]  @relation("CreatedCategories")
  reviewsProduct    Product[]   @relation("ReviewedProducts")
  reviewsArticle    Article[]   @relation("ReviewedArticles")
  reviewsGallery    Gallery[]   @relation("ReviewedGalleries")
  reviewsCategory   Category[]  @relation("ReviewedCategories")
  notifications     Notification[]
  activityLogs      ActivityLog[]
  handledInquiries  Inquiry[]   @relation("HandledInquiries")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(191)
  description String?   @db.Text
  products    Product[]
  approvalStatus ApprovalStatus @default(APPROVED)
  createdById String
  createdBy   User      @relation("CreatedCategories", fields: [createdById], references: [id], onDelete: Restrict)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?          @relation("ReviewedCategories", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  rejectionReason String?       @db.Text
  pendingName        String?  @db.VarChar(100)
  pendingSlug        String?  @db.VarChar(191)
  pendingDescription String?  @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([approvalStatus])
  @@index([createdById])
}

model Product {
  id             String        @id @default(cuid())
  name           String        @db.VarChar(191)
  slug           String        @unique @db.VarChar(191)
  shortDesc      String?       @db.VarChar(500)
  description    String?       @db.Text
  material       String?       @db.VarChar(191)
  dimensions     String?       @db.VarChar(191)
  color          String?       @db.VarChar(191)
  specifications String?       @db.Text
  status         ProductStatus @default(ACTIVE)
  featured       Boolean       @default(false)
  approvalStatus ApprovalStatus @default(APPROVED)
  createdById    String
  createdBy      User           @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: Restrict)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?          @relation("ReviewedProducts", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  rejectionReason String?       @db.Text
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  inquiries      Inquiry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([approvalStatus])
  @@index([createdById])
  @@fulltext([name, shortDesc])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(191)
  sortOrder Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Portfolio {
  id          String           @id @default(cuid())
  title       String           @db.VarChar(191)
  slug        String           @unique @db.VarChar(191)
  client      String?          @db.VarChar(191)
  location    String?          @db.VarChar(191)
  year        Int?
  description String?          @db.Text
  featured    Boolean          @default(false)
  images      PortfolioImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PortfolioImage {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  url         String    @db.VarChar(500)
  alt         String?   @db.VarChar(191)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([portfolioId])
}

model Article {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(191)
  slug        String        @unique @db.VarChar(191)
  excerpt     String?       @db.VarChar(500)
  content     String        @db.LongText
  thumbnail   String?       @db.VarChar(500)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  approvalStatus ApprovalStatus @default(APPROVED)
  createdById    String
  createdBy      User           @relation("CreatedArticles", fields: [createdById], references: [id], onDelete: Restrict)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?          @relation("ReviewedArticles", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  rejectionReason String?       @db.Text
  pendingTitle    String?  @db.VarChar(191)
  pendingSlug     String?  @db.VarChar(191)
  pendingExcerpt  String?  @db.VarChar(500)
  pendingContent  String?  @db.LongText
  pendingThumbnail String? @db.VarChar(500)
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([approvalStatus])
  @@index([createdById])
}

model Gallery {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(191)
  url       String   @db.VarChar(500)
  category  String   @db.VarChar(100)
  approvalStatus ApprovalStatus @default(APPROVED)
  createdById    String
  createdBy      User           @relation("CreatedGalleries", fields: [createdById], references: [id], onDelete: Restrict)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?          @relation("ReviewedGalleries", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  rejectionReason String?       @db.Text
  pendingTitle    String?  @db.VarChar(191)
  pendingCategory String?  @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([approvalStatus])
  @@index([createdById])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(191)
  email     String        @db.VarChar(191)
  whatsapp  String        @db.VarChar(30)
  quantity  Int           @default(1)
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  handledById String?
  handledBy   User?       @relation("HandledInquiries", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([productId])
  @@index([handledById])
}

model CompanyProfile {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  tagline   String?  @db.VarChar(255)
  description String? @db.Text
  history   String?  @db.Text
  vision    String?  @db.Text
  mission   String?  @db.Text
  phone     String?  @db.VarChar(30)
  whatsapp  String?  @db.VarChar(30)
  email     String?  @db.VarChar(191)
  address   String?  @db.Text
  mapsUrl   String?  @db.VarChar(500)
  instagram String?  @db.VarChar(255)
  facebook  String?  @db.VarChar(255)
  linkedin  String?  @db.VarChar(255)
  hours     String?  @db.VarChar(191)
  logoUrl   String?  @db.VarChar(500)
  heroImageUrl String? @db.VarChar(500)
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(191)
  message   String   @db.Text
  link      String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(191)
  fromStatus String?  @db.VarChar(50)
  toStatus   String?  @db.VarChar(50)
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
